# Modèle de configuration de PRODUCTION pour l'API Laravel sur o2switch.
#
# À copier dans le fichier partagé côté serveur : $O2SWITCH_API_PATH/shared/.env
# puis à compléter (base MySQL, clé d'application, URLs, mail, ...).
#
# Générer une APP_KEY : php artisan key:generate --show

APP_NAME=Fanch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.mondomaine.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de données MySQL (identifiants créés dans cPanel) --------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moncompte_fanch
DB_USERNAME=moncompte_fanch
DB_PASSWORD=

# En mutualisé, la base de données est le stockage le plus fiable pour
# les sessions / le cache / les files d'attente (pas de Redis dédié).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Domaine du cookie de session (utile si SPA et API partagent le domaine).
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Sanctum / CORS ------------------------------------------------------
# Domaines de la SPA autorisés à consommer l'API (séparés par des virgules).
SANCTUM_STATEFUL_DOMAINS=app.mondomaine.fr
FRONTEND_URL=https://app.mondomaine.fr

# --- Mail (SMTP o2switch) ------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.mondomaine.fr
MAIL_PORT=465
MAIL_USERNAME=no-reply@mondomaine.fr
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@mondomaine.fr"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
